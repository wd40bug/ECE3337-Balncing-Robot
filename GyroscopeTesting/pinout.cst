IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8;

IO_LOC "lcd_rs" 71;
IO_LOC "lcd_rw" 53;
IO_LOC "lcd_e" 52;
IO_PORT "lcd_rs" PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_rw" PULL_MODE=UP DRIVE=8;
IO_PORT "lcd_e" PULL_MODE=UP DRIVE=8;

IO_LOC "shift_ser" 29;
IO_LOC "shift_rclk" 30;
IO_LOC "shift_srclk" 31;
IO_PORT "shift_ser" PULL_MODE=UP DRIVE=8;
IO_PORT "shift_srclk" PULL_MODE=UP DRIVE=8;
IO_PORT "shift_rclk" PULL_MODE=UP DRIVE=8;

IO_LOC "btn" 88;
IO_PORT "btn" PULL_MODE=UP;

IO_LOC "ena" 42;
IO_LOC "in1" 41;
IO_LOC "in2" 56;
IO_LOC "enb" 54;
IO_LOC "in3" 51;
IO_LOC "in4" 48;
IO_PORT "ena" PULL_MODE=UP DRIVE=8;
IO_PORT "in1" PULL_MODE=UP DRIVE=8;
IO_PORT "in2" PULL_MODE=UP DRIVE=8;
IO_PORT "enb" PULL_MODE=UP DRIVE=8;
IO_PORT "in3" PULL_MODE=UP DRIVE=8;
IO_PORT "in4" PULL_MODE=UP DRIVE=8;

IO_LOC "up" 55;
IO_LOC "down" 49;
IO_LOC "left" 86;
IO_LOC "right" 79;
IO_PORT "up" IO_TYPE=LVCMOS33;
IO_PORT "down" IO_TYPE=LVCMOS33;
IO_PORT "left" IO_TYPE=LVCMOS33;
IO_PORT "right" IO_TYPE=LVCMOS33;
